# Application
PROJECT_NAME=AI Vision Platform
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_vision.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_vision

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Media Server (MediaMTX)
MEDIA_SERVER_URL=http://localhost:8554

# AI Inference Server
INFERENCE_SERVER_URL=http://localhost:8001
