# -*- coding: utf-8 -*-
# AI 视觉平台后端环境变量配置示例
# 复制此文件为 .env 并修改配置值

# ==================== 基础配置 ====================
PROJECT_NAME=AI Vision Platform
ENVIRONMENT=development
DEBUG=true

# ==================== API 配置 ====================
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== 数据库配置 ====================
# MySQL 连接URL格式: mysql+aiomysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/ai_vision
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ==================== JWT 认证配置 ====================
# 生产环境必须修改此密钥!
SECRET_KEY=change-this-secret-key-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== ZLMediaKit 流媒体配置 ====================
ZLM_API_URL=http://localhost:80
ZLM_SECRET=035c73f7-bb6b-4889-a715-d9eb2d1925cc
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=554
ZLM_HTTP_FLV_PORT=80
ZLM_HOOK_ENABLE=true
ZLM_ALLOWED_PUSH_IPS=127.0.0.1,192.168.1.0/24

# ==================== 存储配置 ====================
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data

# MinIO 配置 (当 STORAGE_TYPE=minio 时生效)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=ai-vision
# MINIO_SECURE=false

# ==================== 告警消费者配置 ====================
ALARM_CONSUMER_WORKERS=4
ALARM_QUEUE_NAME=alarm_queue

# ==================== 通知配置 ====================
# 钉钉机器人
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# 邮件配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_PATH=./logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days

# ==================== 引擎配置 ====================
ENGINE_REDIS_CHANNEL=engine:config_update
DEFAULT_INFERENCE_WORKERS=4
MAX_FRAME_QUEUE_SIZE=30
MAX_RESULT_QUEUE_SIZE=100
